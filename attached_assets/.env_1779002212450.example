# ============================================
# Cambridge 9709 RAG Tutor — Environment vars
# Copy this file to .env.local and fill in
# ============================================

# Anthropic (Claude)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — for text-embedding-3-small
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Pinecone Vector DB
# Get at: https://app.pinecone.io
# Free tier: 1 index, 100k vectors — enough for all Cambridge past papers
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=cambridge-9709
PINECONE_ENVIRONMENT=us-east-1-aws

# Admin secret — protects the /api/ingest endpoint
# Set to any random string you choose
ADMIN_SECRET=change-me-to-something-secret

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
